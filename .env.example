# Server-only production secrets. Generate independent random values; never
# copy these placeholders into a real deployment.
TEACHER_SESSION_SECRET=replace_with_at_least_32_random_bytes
STUDENT_SESSION_SECRET=replace_with_at_least_32_random_bytes
STUDENT_ATTEMPT_SECRET=replace_with_at_least_32_random_bytes
OMR_RATE_LIMIT_HASH_SECRET=replace_with_at_least_32_random_bytes

# Supabase server gateway. Keep the service-role key out of browser bundles.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_full_key_here
# Canonical public HTTPS origin used in student QR/invite links across devices.
NEXT_PUBLIC_SHARE_BASE_URL=https://omr.example.com
SUPABASE_SERVICE_ROLE_KEY=replace_with_server_only_service_role_key
# Operator-only PostgreSQL 17 backup connection. Keep these values out of
# browser/deployment environments; the backup runner passes only private file
# paths to child processes, never the password or Supabase keys.
SUPABASE_DB_HOST=db.your-project-ref.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=postgres
SUPABASE_DB_NAME=postgres
SUPABASE_DB_PASSWORD=replace_with_operator_database_password
OMR_POSTGRES_BIN=/absolute/path/to/postgresql-17/bin

# Operations. The sink must accept authenticated HEAD probes and JSON POST events.
OMR_READINESS_TOKEN=replace_with_at_least_32_random_bytes
OMR_OPERATIONAL_SINK_URL=https://your-operations-collector.example/v1/events
OMR_OPERATIONAL_SINK_TOKEN=replace_with_at_least_32_random_bytes
# The HTTPS receiver must verify x-omr-delivery-timestamp and the HMAC-SHA256
# signature over `<timestamp>.<raw JSON body>` before sending account email.
OMR_TEACHER_ACCOUNT_DELIVERY_WEBHOOK_URL=https://your-mailer.example/v1/omr-account-token
OMR_TEACHER_ACCOUNT_DELIVERY_WEBHOOK_SECRET=replace_with_32_to_512_random_non_whitespace_bytes
# The delivery webhook must accept the same HMAC-authenticated, side-effect-free HEAD URL for /api/readyz.
OMR_ASSET_GC_SCHEDULED=1
CRON_SECRET=replace_with_at_least_32_random_bytes
